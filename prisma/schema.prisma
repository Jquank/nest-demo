// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// generator nestjsDto {
//   provider = "prisma-generator-nestjs-dto"
//   output   = "../src/dto"
// }

model User {
  id           Int             @id @default(autoincrement())
  username     String          @unique
  password     String          @default("")
  name         String?
  pinyin       String?
  email        String?         @unique
  gender       Int?
  avatar       String?
  birthDate    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime?       @updatedAt
  lastLoginAt  DateTime?
  isVerified   Boolean         @default(false)
  isActive     Boolean         @default(true)
  roles        Role[]
  Department   Department?     @relation(fields: [departmentId], references: [id])
  departmentId Int?
  prompts      AiImagePrompt[]
  imageRecords AiImageRecord[]
  wallet       Wallet?
  transactions Transaction[]
}

model Department {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  desc      String?
  users     User[]
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  parentId  Int?
  children  Department[] @relation("DepartmentHierarchy")
  createdAt DateTime     @default(now())
}

model LogReq {
  id        Int      @id @default(autoincrement())
  code      Int      @default(-1)
  level     String? // "INFO" | "ERROR" | etc.
  method    String?
  path      String?
  query     String?
  body      String?
  message   String
  duration  String?
  status    Int?
  timestamp DateTime @default(now())
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  desc        String?
  createTime  DateTime @default(now())
  users       User[]
  permissions Json?
}

model Board {
  id             Int      @id @default(autoincrement())
  title          String   @unique
  desc           String?
  createTime     DateTime @default(now())
  creator        String?
  indicatorCount Int?
  cards          Card[]
}

model Card {
  id         Int      @id @default(autoincrement())
  title      String
  createTime DateTime @default(now())
  type       String   @default("50") // 图表卡片类型: 50 代表数字图
  value      String // 表头总数
  x          Int
  y          Int
  w          Int
  h          Int
  i          String
  config     Json? // 卡片配置信息
  data       Json? // 卡片数据信息
  Board      Board?   @relation(fields: [boardId], references: [id])
  boardId    Int?
}

enum EnumType {
  SYSTEM // 系统枚举
  BUSINESS // 业务枚举
  NORMAL // 通用枚举
  COLUMN // 列枚举
}

// 枚举表
model Enum {
  id        Int         @id @default(autoincrement())
  type      EnumType    @default(NORMAL)
  code      String      @unique
  name      String
  desc      String?
  enable    Boolean     @default(true)
  enumItems EnumItems[]
}

// 枚举项
model EnumItems {
  id           Int      @id @default(autoincrement())
  value        String
  label        String
  enLabel      String?
  desc         String?
  enable       Boolean  @default(true)
  isAuthColumn Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  enum         Enum     @relation(fields: [enumId], references: [id])
  enumId       Int
}

// ======== 热点自动生成图文 ========

// 热点分类（如社会、科技、娱乐、财经、AI）
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  hotspots  Hotspot[]
  createdAt DateTime  @default(now())
}

// 每日热点
model Hotspot {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(500)
  summary       String?  @db.Text
  source        String?
  region        String? // 地域: "国内" | "国外"
  heatIndex     Int      @default(0)
  imageUrl      String?
  localImageUrl String?
  images        Json? // 多图片URL数组，如 ["url1","url2"]；下载后替换为本地路径
  contentUrl    String? // 原文/项目链接（如GitHub仓库、教程地址）
  publishDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    Int
}

// ======== AI 生图 ========

// AI 生图模型配置
model AiImageModel {
  id          Int             @id @default(autoincrement())
  name        String          @unique // 模型标识，如 "ernie-image-turbo"
  displayName String // 显示名称，如 "百度文心·图像 turbo"
  apiUrl      String // API 地址
  defaultSize String          @default("1376x768") // 默认图片尺寸
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  records     AiImageRecord[]
  prompts     AiImagePrompt[]
}

// AI 生图提示词模板（系统级 userId=null 人人可见，用户自建绑定 userId）
model AiImagePrompt {
  id        Int             @id @default(autoincrement())
  name      String // 提示词名称
  content   String          @db.Text // 提示词内容
  isSystem  Boolean         @default(false) // 是否系统内置模板
  userId    Int?
  size      String? // 保存时的尺寸，方便回填
  modelId   Int? // 保存时的模型ID，方便回填
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User?           @relation(fields: [userId], references: [id])
  modelRel  AiImageModel?   @relation(fields: [modelId], references: [id])
  records   AiImageRecord[]
}

// AI 生图记录
model AiImageRecord {
  id        Int            @id @default(autoincrement())
  modelId   Int
  promptId  Int?
  prompt    String         @db.Text // 实际使用的提示词
  size      String // 生成尺寸
  imageUrl  String // 图片访问URL
  localPath String // 本地存储路径
  userId    Int?
  createdAt DateTime       @default(now())
  model     AiImageModel   @relation(fields: [modelId], references: [id])
  promptRel AiImagePrompt? @relation(fields: [promptId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
}

// ======== 计费充值 ========

// 用户钱包（1:1）
model Wallet {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  balance        Int      @default(0) // 余额（单位：分）
  totalRecharged Int      @default(0) // 累计充值
  totalConsumed  Int      @default(0) // 累计消费
  version        Int      @default(0) // 乐观锁
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

// 交易流水
model Transaction {
  id            Int      @id @default(autoincrement())
  userId        Int
  type          String // RECHARGE | CONSUME | REFUND
  amount        Int // 金额（分），充值为正、消费为负
  balanceBefore Int // 操作前余额
  balanceAfter  Int // 操作后余额
  relatedType   String? // 关联业务：AI_IMAGE | ADMIN_RECHARGE
  relatedId     Int? // 关联记录ID
  description   String? // 备注
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}
