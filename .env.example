# ======== 数据库 ========
DATABASE_URL="mysql://user:password@127.0.0.1:3306/nest_demo"

# ======== JWT ========
JWT_SECRET="your-jwt-secret-here"

# ======== AI 对话（DeepSeek API） ========
AI_API_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-your-deepseek-key
AI_MODEL=deepseek-v4-flash

# ======== AI 生图 — 百度千帆 ERNIE-Image-Turbo ========
AI_IMAGE_API_URL=https://qianfan.baidubce.com/v2/images/generations
AI_IMAGE_API_KEY=your-baidu-qianfan-access-token
AI_IMAGE_MODEL=ernie-image-turbo

# ======== AI 生图 — ModelScope Z-Image 系列 ========
# 注册后获取：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=ms-your-modelscope-token

# ======== 应用端口（可选） ========
PORT=3000
